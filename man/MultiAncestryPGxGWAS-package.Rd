\name{MultiAncestryPGxGWAS-package}
\alias{MultiAncestryPGxGWAS-package}
\alias{MultiAncestryPGxGWAS}
\title{MultiAncestryPGxGWAS: Multi-Population PGx Simulation and GxE Workflow}
\description{
Refactored package interface for the MultiAncestryPGxGWAS workflow, including simulation, summary,
and HPC command mapping helpers.
}
\details{
Main entry points include \code{mpgx_prepare_example_genotype()},
\code{mpgx_simulate_phenotypes()}, and summary utilities.
External-tool wrappers are provided for GCTA, fastGWA, LEMMA, and GEM.
}
